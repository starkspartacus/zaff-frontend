# URL de l'API NestJS (zaff-backend, port 8000 par défaut)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Adresse publique de l'application, imprimée dans le QR code de garantie (ex. : https://app.zaff.ci).
# Sans elle, le QR pointe vers l'adresse ouverte dans le navigateur au moment de l'impression.
# NEXT_PUBLIC_APP_URL=https://app.zaff.ci
